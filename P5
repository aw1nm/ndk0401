    def validate_phone(self, value):
        """Проверка уникальности телефона."""
        qs = Client.objects.filter(phone=value)
        if self.instance:
            qs = qs.exclude(pk=self.instance.pk)
        if qs.exists():
            raise serializers.ValidationError("Клиент с таким телефоном уже есть")
        return value

